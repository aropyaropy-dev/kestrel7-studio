name: Extract Android Project

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  extract:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Extract project
        run: |
          mkdir -p temp
          unzip -o Kestrel7_Android_Project_Mobile_Build_v2.zip -d temp
          cp -a temp/Kestrel7_Android_Project/. .
          rm -rf temp

      - name: Save extracted files
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add .
          git commit -m "Extract Android project" || true
          git push
